PORT=8080
DB_FILE=./data/medvault.db
# Required in production. Generate each with: openssl rand -base64 32
# MASTER_KEY wraps every record's data key; losing it makes all records unreadable.
MASTER_KEY=
SESSION_SECRET=
# Demo users and records are created on an empty database; set to "off" for real deployments.
DEMO_SEED=on
